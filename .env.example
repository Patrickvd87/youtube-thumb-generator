APP_PASSWORD=change-me
AUTH_SECRET=generate-a-long-random-string

# Free image generation (recommended). Cloudflare Workers AI daily allowance.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Paid Gemini image API. Free-tier quota for gemini-2.5-flash-image is 0.
# IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# Optional: skip the OAuth file and paste a refresh token here
# YOUTUBE_REFRESH_TOKEN=
